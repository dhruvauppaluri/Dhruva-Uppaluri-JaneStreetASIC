set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY pin_generator
set_global_assignment -name SYSTEMVERILOG_FILE ../../pin_generator.sv
set_global_assignment -name SDC_FILE pin_generator.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4

set_instance_assignment -name VIRTUAL_PIN ON -to reset
set_instance_assignment -name VIRTUAL_PIN ON -to enable
set_instance_assignment -name VIRTUAL_PIN ON -to cycles_per_toggle[*]
set_instance_assignment -name VIRTUAL_PIN ON -to pin_out

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"