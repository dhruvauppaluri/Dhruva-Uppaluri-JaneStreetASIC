[tasks]
bmc
reach
prove

[options]
bmc: mode bmc
bmc: depth 110
bmc: aigsmt none
reach: mode bmc
reach: depth 110
reach: expect fail
reach: aigsmt none
prove: mode prove
prove: aigsmt z3

[engines]
bmc: abc bmc3
reach: abc bmc3
prove: abc pdr

[script]
read -formal setl_lane.v setl_fifo.v
bmc: read -formal -I. fv_spi.v
prove: read -formal -I. fv_spi.v
reach: read -formal -DREACH -I. fv_spi.v
prep -top fv_spi

[files]
../src/setl_lane.v
../src/setl_fifo.v
fv_env.vh
fv_spi.v
build/spi/rom.vh
build/spi/sym.vh
